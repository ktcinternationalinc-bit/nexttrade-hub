-- Select the reviewed default revenue account used only for future source-backed invoices.
-- Example: -v actor_uuid=... -v income_account_uuid=... -v evidence='CPA-reviewed Product Sales mapping dated YYYY-MM-DD'
\set ON_ERROR_STOP on
begin;
select set_config('cb.actor', :'actor_uuid', true);
do $$ begin if not exists(select 1 from public.bank_visibility_identity_map() where auth_user_id=current_setting('cb.actor')::uuid) then raise exception 'CB_IDENTITY_NOT_VERIFIED'; end if; end $$;
select clickbooks_us.set_posting_default(:'income_account_uuid'::uuid,:'evidence',:'actor_uuid'::uuid);
commit;
